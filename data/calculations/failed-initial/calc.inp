  &DFT
    CHARGE 0
    MULTIPLICITY 1
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD xTB
      &xTB
        GFN_TYPE 1
      &END xTB
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &SCF
      MAX_SCF 20
      EPS_SCF 1.0E-08
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
        ALGORITHM STRICT
      &END OT
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-08
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 1
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    KEEP_SPACE_GROUP T
    OPTIMIZER BFGS
    &BFGS
      TRUST_RADIUS 0.2
    &END BFGS
    MAX_ITER 100
    MAX_DR 3.0E-04
    RMS_DR 1.5E-04
    MAX_FORCE 4.5E-05
    RMS_FORCE 3.0E-05
  &END GEO_OPT
  &CONSTRAINT
    &FIXED_ATOMS
      COMPONENTS_TO_FIX XYZ
      LIST 1..32
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    &FORCES
      FORMAT XYZ
    &END FORCES
    &RESTART
      BACKUP_COPIES 1
    &END RESTART
  &END PRINT
&END MOTION
