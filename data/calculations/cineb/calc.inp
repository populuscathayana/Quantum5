&GLOBAL
  PROJECT neb
  PRINT_LEVEL LOW
  RUN_TYPE BAND
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &SUBSYS
    &CELL
      A 10.666564372843 0.000000000000 0.000000000000
      B 5.333282186421 9.237515717984 0.000000000000
      C 0.000000000000 0.000000000000 46.531910005504
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME ../../structures/hcp.xyz
    &END TOPOLOGY
  &END SUBSYS

  &DFT
    CHARGE 0
    MULTIPLICITY 1
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD xTB
      &xTB
        GFN_TYPE 1
      &END xTB
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &SCF
      MAX_SCF 20
      EPS_SCF 1.0E-06
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
        ALGORITHM STRICT
      &END OT
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-06
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 0
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
&END FORCE_EVAL

&MOTION
  &BAND
    BAND_TYPE CI-NEB
    &REPLICA
      COORD_FILE_NAME ../../structures/hcp.xyz
    &END REPLICA
    &REPLICA
      COORD_FILE_NAME ../../structures/fcc.xyz
    &END REPLICA
    K_SPRING 0.05
    NUMBER_OF_REPLICA 5
    NPROC_REP 1
    ALIGN_FRAMES F
    ROTATE_FRAMES F
    &CI_NEB
      NSTEPS_IT 2
    &END CI_NEB
    &OPTIMIZE_BAND
      OPTIMIZE_END_POINTS F
      &DIIS
        MAX_STEPS 100
        MAX_STEPSIZE 2.0
      &END DIIS
    &END OPTIMIZE_BAND
    &CONVERGENCE_CONTROL
      MAX_DR 0.002
      RMS_DR 0.001
      MAX_FORCE 0.0045
      RMS_FORCE 0.003
    &END CONVERGENCE_CONTROL
    &PROGRAM_RUN_INFO
      PLOT_REL_ENERGY T
      INITIAL_CONFIGURATION_INFO F
    &END PROGRAM_RUN_INFO
    &CONVERGENCE_INFO
    &END CONVERGENCE_INFO
  &END BAND
  &CONSTRAINT
    &FIXED_ATOMS
      COMPONENTS_TO_FIX XYZ
      LIST 1..64
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &RESTART
      BACKUP_COPIES 0
    &END RESTART
  &END PRINT
&END MOTION
